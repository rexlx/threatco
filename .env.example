# ThreatCo Environment Variables Example
# Copy this file to .env and adjust values as needed.

# Application Environment (development | production)
APP_ENV=development

# Application Ports
APP_PORT=8080
METRICS_PORT=8089

# Database Configuration (PostgreSQL)
DB_USER=threatco
DB_PASSWORD=threatcopass
DB_NAME=threatco
DB_HOST=db
DB_PORT=5554

# ThreatCo Database Location (Postgres DSN connection string)
THREATCO_DB_LOCATION=postgres://threatco:threatcopass@db:5432/threatco?sslmode=disable

# ThreatCo Encryption Key (REQUIRED for AES-256 GCM token/password encryption)
# Must be 32 bytes encoded as 64 hex characters:
THREATCO_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Optional old encryption key for seamless key rotation
# THREATCO_OLD_ENCRYPTION_KEY=

# Initial Administrator Credentials (used during first-use mode)
ADMIN_EMAIL=admin@aol.com
ADMIN_PASSWORD=admin
INIT_ADMIN=true

# Configuration File Path on Host (mounted to /config.json in container)
CONFIG_PATH=./config.json

# Optional: Threat Intelligence Service API Keys
# These override or populate empty keys in config.json services automatically:
MISP_KEY=
MISP_SECRET=
VIRUSTOTAL_KEY=
VIRUSTOTAL_SECRET=
URLSCAN_KEY=
URLSCAN_SECRET=
LIVERY_KEY=
LIVERY_SECRET=
DEEPFRY_KEY=
DEEPFRY_SECRET=
ABUSEIPDB_KEY=
ABUSEIPDB_SECRET=
OTX_KEY=
OTX_SECRET=
VMRAY_KEY=
VMRAY_SECRET=
CROWDSTRIKE_KEY=
CROWDSTRIKE_SECRET=
CLOUDFLARE_KEY=
CLOUDFLARE_SECRET=
MANDIANT_KEY=
MANDIANT_SECRET=
SPLUNK_KEY=
SPLUNK_SECRET=

# Optional: LLM Integration (Gemini, OpenAI, etc.)
THREATCO_LLM_API_KEY=

# Syslog Logging (optional)
USE_SYSLOG=false
SYSLOG_HOST=
